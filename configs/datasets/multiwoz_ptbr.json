{
  "schema_version": "queroquero-dataset-config/v1",
  "dataset_id": "multiwoz_ptbr",
  "adapter": "multiwoz_ptbr",
  "source": {
    "root_env": "PTBR_DATASET_ROOT",
    "relative_directory": "multiwozptbr",
    "format": "json-array",
    "file_pattern": "dialogues_*.json",
    "expected_files": 17,
    "encoding": "utf-8",
    "checkpoint_every": 128
  },
  "filters": {
    "projection": "utterances_only",
    "speaker_labels": {
      "USER": "Usuário",
      "SYSTEM": "Assistente"
    },
    "exclude_frames_slots_states": true
  },
  "profiles": {
    "smoke": {
      "train_sequences": 8,
      "eval_sequences": 2,
      "candidate_documents": 128,
      "selection": "representative"
    },
    "mvp": {
      "train_sequences": 256,
      "eval_sequences": 32,
      "candidate_documents": 4096,
      "selection": "representative"
    }
  }
}
