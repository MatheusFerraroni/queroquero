{
  "adapter": "outerspace",
  "dataset_id": "outerspace",
  "filters": {
    "anonymize_participants": true,
    "omit_timestamps": true,
    "strict_three_columns": true,
    "strip_html": true
  },
  "profiles": {
    "mvp": {
      "candidate_documents": 4096,
      "eval_sequences": 32,
      "selection": "representative",
      "train_sequences": 256
    },
    "paired_real": {
      "allocation_policy": "matched_domain_substitution_without_replacement",
      "allocation_sha256": "72ac3f40e07866c1e204a5aba81eb8e17829d28ee3587537cd38cb2bc33a6368",
      "candidate_documents": 250000,
      "eval_sequences": 256,
      "pools": [
        {
          "pool_id": "outerspace_domain",
          "role": "domain",
          "start_row": 0,
          "train_sequences": 82779
        }
      ],
      "selection": "representative",
      "train_sequences": 82779,
      "without_replacement": true
    },
    "smoke": {
      "candidate_documents": 128,
      "eval_sequences": 2,
      "selection": "representative",
      "train_sequences": 8
    }
  },
  "schema_version": "queroquero-dataset-config/v1",
  "source": {
    "archives_by_profile": {
      "mvp": "outerspace/conversations.zip",
      "smoke": "outerspace/conversations_min.zip"
    },
    "checkpoint_every": 64,
    "columns": [
      "timestamp",
      "user",
      "text"
    ],
    "encoding": "utf-8",
    "format": "zip-tsv",
    "has_header": false,
    "member_pattern": "clear_threads/*.tsv",
    "root_env": "PTBR_DATASET_ROOT"
  }
}
