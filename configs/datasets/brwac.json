{
  "schema_version": "queroquero-dataset-config/v1",
  "dataset_id": "brwac",
  "adapter": "brwac",
  "source": {
    "root_env": "PTBR_DATASET_ROOT",
    "path": "BrWac-CLEAN/BrWac.zip",
    "format": "zip",
    "member_glob": "data/*.txt",
    "encoding": "utf-8",
    "checkpoint_interval_documents": 64
  },
  "filters": {
    "strict_utf8": true
  },
  "profiles": {
    "smoke": {
      "train_sequences": 8,
      "eval_sequences": 2,
      "candidate_documents": 128,
      "selection": "representative"
    },
    "mvp": {
      "train_sequences": 256,
      "eval_sequences": 32,
      "candidate_documents": 4096,
      "selection": "representative"
    }
  }
}
