{
  "schema_version": "queroquero-dataset-config/v1",
  "dataset_id": "adrenaline",
  "adapter": "adrenaline",
  "source": {
    "root_env": "PTBR_DATASET_ROOT",
    "archives_by_profile": {
      "smoke": "adrenaline/conversations_min.zip",
      "mvp": "adrenaline/conversations.zip"
    },
    "format": "zip-tsv",
    "member_pattern": "clear_threads/*.tsv",
    "encoding": "utf-8",
    "columns": [
      "timestamp",
      "user",
      "text"
    ],
    "has_header": false,
    "checkpoint_every": 64
  },
  "filters": {
    "strict_three_columns": true,
    "anonymize_participants": true,
    "omit_timestamps": true,
    "strip_html": true
  },
  "profiles": {
    "smoke": {
      "train_sequences": 8,
      "eval_sequences": 2,
      "candidate_documents": 128,
      "selection": "representative"
    },
    "mvp": {
      "train_sequences": 256,
      "eval_sequences": 32,
      "candidate_documents": 4096,
      "selection": "representative"
    }
  }
}
