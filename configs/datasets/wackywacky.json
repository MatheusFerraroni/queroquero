{
  "schema_version": "queroquero-dataset-config/v1",
  "dataset_id": "wackywacky",
  "adapter": "wackywacky",
  "source": {
    "root_env": "PTBR_DATASET_ROOT",
    "path": "wacky/pages.tsv",
    "format": "tsv",
    "encoding": "utf-8",
    "text_encoding": "hex-zstd-utf8",
    "max_decompressed_text_bytes": 134217728,
    "discard_truncated_zstd_frame_size_bytes": 65535,
    "text_decode_error_policy": "discard",
    "columns": [
      "id",
      "domain_id",
      "parent_page_id",
      "same_as",
      "url",
      "url_md5",
      "url_final",
      "url_final_md5",
      "status_code",
      "title",
      "recursion_level",
      "status",
      "retry_count",
      "text",
      "html",
      "text_md5",
      "html_md5",
      "created_at",
      "updated_at"
    ],
    "max_field_size_bytes": 134217728,
    "checkpoint_interval_records": 50000,
    "fingerprint_sample_bytes": 65536
  },
  "filters": {
    "status": "done",
    "require_text": true,
    "require_text_md5": true,
    "text_md5_policy": "count_mismatch",
    "exclude_same_as": true,
    "same_as_null_values": ["", "NULL"],
    "page_filter": {
      "search_title_markers": [
        "resultados da pesquisa",
        "resultados de pesquisa",
        "resultados da busca",
        "resultados de busca",
        "search results"
      ],
      "search_query_parameters": ["search"],
      "search_query_value_markers": ["especial:pesquisar", "special:search"],
      "search_path_segments": ["search", "busca", "buscar", "pesquisa", "pesquisar"],
      "listing_path_segments": [
        "tag",
        "tags",
        "category",
        "categories",
        "categoria",
        "categorias",
        "archive",
        "archives",
        "arquivo",
        "arquivos"
      ]
    },
    "line_filter": {
      "minimum_characters": 40
    },
    "boilerplate": {
      "schema_version": 4,
      "decision_by_profile": {
        "smoke": "remove_exact",
        "mvp": "remove_exact"
      },
      "cross_domain_paragraphs": {
        "minimum_characters": 80,
        "minimum_documents": 5,
        "minimum_domains": 3
      },
      "within_domain_blocks": {
        "lines_per_block": 3,
        "minimum_characters": 60,
        "minimum_documents": 5
      },
      "document_filter": {
        "minimum_remaining_characters": 300,
        "maximum_removed_fraction": 0.8
      }
    }
  },
  "profiles": {
    "smoke": {
      "train_sequences": 8,
      "eval_sequences": 2,
      "candidate_documents": 128,
      "selection": "engineering_prefix"
    },
    "mvp": {
      "train_sequences": 256,
      "eval_sequences": 32,
      "candidate_documents": 4096,
      "selection": "representative"
    }
  }
}
