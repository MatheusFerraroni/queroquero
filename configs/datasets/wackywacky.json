{
  "adapter": "wackywacky",
  "dataset_id": "wackywacky",
  "filters": {
    "boilerplate": {
      "cross_domain_paragraphs": {
        "minimum_characters": 80,
        "minimum_documents": 5,
        "minimum_domains": 3
      },
      "decision_by_profile": {
        "mvp": "remove_exact",
        "smoke": "remove_exact"
      },
      "document_filter": {
        "maximum_removed_fraction": 0.8,
        "minimum_remaining_characters": 300
      },
      "schema_version": 4,
      "within_domain_blocks": {
        "lines_per_block": 3,
        "minimum_characters": 60,
        "minimum_documents": 5
      }
    },
    "exclude_same_as": true,
    "line_filter": {
      "minimum_characters": 40
    },
    "page_filter": {
      "listing_path_segments": [
        "tag",
        "tags",
        "category",
        "categories",
        "categoria",
        "categorias",
        "archive",
        "archives",
        "arquivo",
        "arquivos"
      ],
      "search_path_segments": [
        "search",
        "busca",
        "buscar",
        "pesquisa",
        "pesquisar"
      ],
      "search_query_parameters": [
        "search"
      ],
      "search_query_value_markers": [
        "especial:pesquisar",
        "special:search"
      ],
      "search_title_markers": [
        "resultados da pesquisa",
        "resultados de pesquisa",
        "resultados da busca",
        "resultados de busca",
        "search results"
      ]
    },
    "require_text": true,
    "require_text_md5": true,
    "same_as_null_values": [
      "",
      "NULL"
    ],
    "status": "done",
    "text_md5_policy": "count_mismatch"
  },
  "profiles": {
    "mvp": {
      "candidate_documents": 4096,
      "eval_sequences": 32,
      "selection": "representative",
      "train_sequences": 256
    },
    "paired_real": {
      "allocation_policy": "matched_domain_substitution_without_replacement",
      "allocation_sha256": "72ac3f40e07866c1e204a5aba81eb8e17829d28ee3587537cd38cb2bc33a6368",
      "candidate_documents": 250000,
      "eval_sequences": 256,
      "pools": [
        {
          "pool_id": "wackywacky_shared",
          "role": "shared",
          "start_row": 0,
          "train_sequences": 82779
        }
      ],
      "selection": "representative",
      "train_sequences": 82779,
      "without_replacement": true
    },
    "smoke": {
      "candidate_documents": 128,
      "eval_sequences": 2,
      "selection": "engineering_prefix",
      "train_sequences": 8
    }
  },
  "schema_version": "queroquero-dataset-config/v1",
  "source": {
    "checkpoint_interval_records": 50000,
    "columns": [
      "id",
      "domain_id",
      "parent_page_id",
      "same_as",
      "url",
      "url_md5",
      "url_final",
      "url_final_md5",
      "status_code",
      "title",
      "recursion_level",
      "status",
      "retry_count",
      "text",
      "html",
      "text_md5",
      "html_md5",
      "created_at",
      "updated_at"
    ],
    "discard_truncated_zstd_frame_size_bytes": 65535,
    "encoding": "utf-8",
    "fingerprint_sample_bytes": 65536,
    "format": "tsv",
    "max_decompressed_text_bytes": 134217728,
    "max_field_size_bytes": 134217728,
    "path": "wacky/pages.tsv",
    "root_env": "PTBR_DATASET_ROOT",
    "text_decode_error_policy": "discard",
    "text_encoding": "hex-zstd-utf8"
  }
}
